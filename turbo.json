{
  "$schema": "https://turborepo.org/schema.json",
  "pipeline": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": [],
      "outputs": [],
      "inputs": [
        "tests/**",
        "src/**",
        "package.json",
        "../../packages/dudes-sprite/src/**"
      ]
    },
    "type-check": {
      "dependsOn": [],
      "inputs": [
        "src/**",
        "tests/**",
        "package.json",
        "../../packages/dudes-sprite/src/**"
      ]
    }
  }
}
